{
  "name": "tabmaker",
  "version": "1.0.0",
  "description": "Paste a song link, get guitar tab",
  "private": true,
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=esm --minify --outfile=public/app.js && node -e \"const fs=require('fs');fs.cpSync('node_modules/@spotify/basic-pitch/model','public/model',{recursive:true});const mp='node_modules/@mediapipe/tasks-vision/';fs.mkdirSync('public/mediapipe/wasm',{recursive:true});fs.copyFileSync(mp+'vision_bundle.mjs','public/mediapipe/vision_bundle.mjs');for(const f of ['vision_wasm_internal.js','vision_wasm_internal.wasm'])fs.copyFileSync(mp+'wasm/'+f,'public/mediapipe/wasm/'+f)\"",
    "build:site": "node tools/build-site.mjs ../_site",
    "start": "python server.py --open"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "@spotify/basic-pitch": "^1.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
