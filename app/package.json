{
  "name": "tabmaker",
  "version": "1.0.0",
  "description": "Paste a song link, get guitar tab",
  "private": true,
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=esm --minify --outfile=public/app.js && node -e \"require('fs').cpSync('node_modules/@spotify/basic-pitch/model', 'public/model', {recursive: true})\"",
    "build:site": "node tools/build-site.mjs ../_site",
    "start": "python server.py --open"
  },
  "license": "ISC",
  "dependencies": {
    "@spotify/basic-pitch": "^1.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
